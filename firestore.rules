rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admin management
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Inventory: publicly readable, writable only by server (Admin SDK) or authenticated admin
    match /inventory/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: creation permitted; read/update restricted to owner or admin
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          (resource.data.customer != null && resource.data.customer.userId == request.auth.uid) ||
          (resource.data.customer != null && resource.data.customer.email == request.auth.token.email)
        )
      );
      allow update, delete: if isAdmin();
    }

    // Reviews: publicly readable, writable by authenticated buyer or admin
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
