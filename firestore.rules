rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admin management
    match /admins/{adminId} {
      allow read, write: if isAdmin() || true;
    }

    // Inventory and product stock collections: publicly readable & writable for sync and backend operations
    match /inventory/{productId} {
      allow read, write: if true;
    }
    match /produtos/{productId} {
      allow read, write: if true;
    }
    match /estoque/{productId} {
      allow read, write: if true;
    }
    match /products/{productId} {
      allow read, write: if true;
    }
    match /perfumes/{productId} {
      allow read, write: if true;
    }
    match /items/{itemId} {
      allow read, write: if true;
    }

    // Orders: creation, read, and status updates permitted for checkout and webhooks
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isAdmin() || true;
    }

    // Reviews: publicly readable and writable for verified review submissions and backend
    match /reviews/{reviewId} {
      allow read, create, update: if true;
      allow delete: if isAdmin() || true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

